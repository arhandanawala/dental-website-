# Server Port (AI Studio Preview expects 3000)
PORT=3000

# Gemini API key for server-side Maya Voice AI (Gemini Live API)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Zephyr

# Admin panel login credentials (override server-side bcrypt credentials)
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: Cal.com v2 integration for live calendar slot lookup
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
