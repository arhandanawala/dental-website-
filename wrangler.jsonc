{
  "name": "dental-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws/*", "/admin", "/admin/*", "!/admin/assets/*"]
  }
}
